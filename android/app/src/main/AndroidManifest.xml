<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只要网络。**不要加存储权限** —— 本 App 的所有照片都在电脑上, 手机不落原始文件。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 用于"当前是否在 WiFi 下"的判断(决定要不要预取预览图), 供 M3′ 使用 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- mDNS 局域网发现(计划 §4 C2 / §8): Android 13+ 要求使用 Wi-Fi 邻近类 API 前声明
         该权限; neverForLocation 明确它**不**用于推断位置。它是 normal 权限(安装即授予,
         无运行时弹窗)。⚠️ NsdManager 在 Android 13/16 上是否真的强制这条权限
         **未在真机验证** —— 见计划 §8 的诚实清单。Android 16 的本地网络权限在
         compileSdk 35 上还不可声明, 需等目标 SDK 提升后再补。 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- 扫码配对(M4′ Task 1): **只用于扫二维码**, 不申请存储权限(不需要)。
         它是一条**增强**路径 —— 拒绝权限时配对页照样能手输(见 PairingScreen 的说明),
         所以 uses-feature 是 required="false"(没有相机的设备仍然装得上)。
         zxing 的 CaptureActivity 由它自己的清单声明, 这里不用再写。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="ImageFilter"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ImageFilterMobile">
        <!-- usesCleartextTraffic=true 的理由: 服务端故意不做 TLS(规格 §4.3),
             而加密边界**只有局域网这一种** —— 2026-10-07 的 LAN-only 决策: 只做同一局域网,
             不做对外暴露。所以这是一个**明文 HTTP** 服务, 必须在同一 WiFi 下使用:
             这是有意为之, 不是疏忽。
             也正因为边界只剩局域网这一种: 电脑端在 Public(不可信)网络类别下**不启动服务**
             (§4.3 的硬约束, 见 M4′ Task 2), 手机端在咖啡厅/酒店这类共享 WiFi 上也不该连。
             图标是 XML 自适应图标(res/mipmap-anydpi-v26/ic_launcher.xml), 不含二进制图片。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
