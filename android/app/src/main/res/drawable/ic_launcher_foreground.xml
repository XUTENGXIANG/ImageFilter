<!--
  自适应图标前景层: 与桌面端 `src-tauri/icons/icon.png` 同一个标记 ——
  青色圆环 + 两条支腿 + 中间实心楔形。颜色取自桌面 PNG:
  标记 #10B981、背景 #18181B(见 values/ic_launcher_background.xml)。

  刻意用矢量而不是 PNG: 仓库保持纯文本, 图标也能在 diff 里被评审。
  原始几何按 512px 画布绘制, 再用 group 缩放到 108dp 画布的中心安全区;
  标记外接框约 57×60dp, 落在自适应图标 66dp 安全圆内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.153"
        android:scaleY="0.153"
        android:translateX="14.9"
        android:translateY="8.8">

        <!-- 圆环: 原始中心 (256,195), 半径 80.5, 描边 23。
             起点 (256,114.5) 是圆的**顶端**, 不是圆心; 两段弧绕 (256,195) 合拢。 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#10B981"
            android:strokeWidth="23"
            android:strokeLineCap="round"
            android:pathData="M256,114.5 a80.5,80.5 0 1,0 0,161 a80.5,80.5 0 1,0 0,-161" />

        <!-- 左支腿: (248,250) → (82,478), 描边 29 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#10B981"
            android:strokeWidth="29"
            android:strokeLineCap="round"
            android:pathData="M248,250 L82,478" />

        <!-- 右支腿: (263,250) → (430,478), 描边 29 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#10B981"
            android:strokeWidth="29"
            android:strokeLineCap="round"
            android:pathData="M263,250 L430,478" />

        <!-- 中间的实心楔形(桌面图标里连接两条支腿的那一块) -->
        <path
            android:fillColor="#10B981"
            android:pathData="M232,250 L280,250 L256,300 Z" />
    </group>
</vector>
