<!--
  自适应图标前景层: 一张"照片"(浅色圆角矩形) + 山 + 太阳(琥珀).
  刻意用矢量而不是 PNG: 仓库保持纯文本, 图标也能在 diff 里被评审。
  取景范围 28..80(共 52dp) 落在自适应图标 108dp 画布的 66dp 安全区内,
  所以任何厂商的遮罩(圆/方/水滴)都不会切掉主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 相框(照片本体) -->
    <path
        android:fillColor="#F2F2F7"
        android:pathData="M33,32 h42 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-42 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z" />

    <!-- 左边大山 -->
    <path
        android:fillColor="#101014"
        android:pathData="M33,71 L45,51 L57,71 Z" />

    <!-- 右边小山 -->
    <path
        android:fillColor="#2E2E36"
        android:pathData="M52,71 L61,57 L70,71 Z" />

    <!-- 太阳 -->
    <path
        android:fillColor="#F5A524"
        android:pathData="M62,44 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 z" />
</vector>
